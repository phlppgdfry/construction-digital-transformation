<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_c2_tobe" targetNamespace="https://halverdijk.example/bpmn" exporter="construction-digital-transformation/scripts/bpmn.mjs" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_c2_tobe">
    <bpmn:documentation>Gewenste werkwijze: de werfleider meldt in de app (ook offline). De flow maakt het dossier, triageert, verwittigt en start de aangifte. Goedkeuring volgt beslistabel DT-02 en de kosten landen op het project.</bpmn:documentation>
    <bpmn:participant id="Pool_c2_tobe" name="Halverdijk Aannemingen" processRef="Process_c2_tobe" />
  </bpmn:collaboration>
  <bpmn:process id="Process_c2_tobe" name="TO-BE — digitale schadeclaim van werf tot afsluiting" isExecutable="false">
    <bpmn:laneSet id="LaneSet_c2_tobe">
      <bpmn:lane id="Lane_c2_tobe_wl" name="Werfleider (werfapp)">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_c2_tobe_flow" name="Power Automate">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_c2_tobe_ass" name="Beoordelaar (fleet / claims / PL)">
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_c2_tobe_app" name="Goedkeurders (DT-02)">
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_c2_tobe_ext" name="Verzekeraar / derden">
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Schade vastgesteld">
      <bpmn:outgoing>Flow_c2_tobe_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="t1" name="Melden in app: foto's, GPS, categorie">
      <bpmn:documentation>Werkt offline; synchroniseert met een client-id zodat dubbel verzenden geen dubbel dossier geeft.</bpmn:documentation>
      <bpmn:incoming>Flow_c2_tobe_1</bpmn:incoming>
      <bpmn:outgoing>Flow_c2_tobe_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g0" name="Personen-letsel?" default="Flow_c2_tobe_4">
      <bpmn:incoming>Flow_c2_tobe_2</bpmn:incoming>
      <bpmn:outgoing>Flow_c2_tobe_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_c2_tobe_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e0" name="Procedure arbeidsongeval">
      <bpmn:incoming>Flow_c2_tobe_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t2" name="Dossier aanmaken + triage (ernst, eigenaar)">
      <bpmn:incoming>Flow_c2_tobe_4</bpmn:incoming>
      <bpmn:outgoing>Flow_c2_tobe_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="p1" name="">
      <bpmn:incoming>Flow_c2_tobe_5</bpmn:incoming>
      <bpmn:outgoing>Flow_c2_tobe_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_c2_tobe_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_c2_tobe_8</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sendTask id="t3" name="Betrokkenen verwittigen (Teams / mail)">
      <bpmn:incoming>Flow_c2_tobe_6</bpmn:incoming>
      <bpmn:outgoing>Flow_c2_tobe_9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="e5" name="Verwittigd">
      <bpmn:incoming>Flow_c2_tobe_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="t4" name="Beoordelen: oorzaak, aansprakelijk-heid, raming">
      <bpmn:incoming>Flow_c2_tobe_7</bpmn:incoming>
      <bpmn:incoming>Flow_c2_tobe_13</bpmn:incoming>
      <bpmn:outgoing>Flow_c2_tobe_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="t5" name="Aangifte-concept naar verzekeraar (≤ 8 dagen)">
      <bpmn:incoming>Flow_c2_tobe_8</bpmn:incoming>
      <bpmn:outgoing>Flow_c2_tobe_10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="e6" name="Aangifte verstuurd">
      <bpmn:incoming>Flow_c2_tobe_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="g2" name="Info volledig?" default="Flow_c2_tobe_14">
      <bpmn:incoming>Flow_c2_tobe_11</bpmn:incoming>
      <bpmn:outgoing>Flow_c2_tobe_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_c2_tobe_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t6" name="Aanvullen in app">
      <bpmn:incoming>Flow_c2_tobe_12</bpmn:incoming>
      <bpmn:outgoing>Flow_c2_tobe_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:businessRuleTask id="t7" name="Goedkeurings-keten bepalen (DT-02)">
      <bpmn:incoming>Flow_c2_tobe_14</bpmn:incoming>
      <bpmn:outgoing>Flow_c2_tobe_15</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:userTask id="t8" name="Goedkeuren in Teams (per niveau)">
      <bpmn:incoming>Flow_c2_tobe_15</bpmn:incoming>
      <bpmn:incoming>Flow_c2_tobe_17</bpmn:incoming>
      <bpmn:outgoing>Flow_c2_tobe_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g4" name="Beslissing?" default="Flow_c2_tobe_19">
      <bpmn:incoming>Flow_c2_tobe_16</bpmn:incoming>
      <bpmn:outgoing>Flow_c2_tobe_17</bpmn:outgoing>
      <bpmn:outgoing>Flow_c2_tobe_18</bpmn:outgoing>
      <bpmn:outgoing>Flow_c2_tobe_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e7" name="Afgewezen, melder geïnformeerd">
      <bpmn:incoming>Flow_c2_tobe_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="t10" name="Herstel, vergoeding of verhaal afhandelen">
      <bpmn:incoming>Flow_c2_tobe_19</bpmn:incoming>
      <bpmn:outgoing>Flow_c2_tobe_20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t11" name="Kosten en recuperatie boeken op project (ERP)">
      <bpmn:incoming>Flow_c2_tobe_20</bpmn:incoming>
      <bpmn:outgoing>Flow_c2_tobe_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e1" name="Dossier afgesloten">
      <bpmn:incoming>Flow_c2_tobe_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_c2_tobe_1" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_c2_tobe_2" sourceRef="t1" targetRef="g0" />
    <bpmn:sequenceFlow id="Flow_c2_tobe_3" sourceRef="g0" targetRef="e0" name="ja" />
    <bpmn:sequenceFlow id="Flow_c2_tobe_4" sourceRef="g0" targetRef="t2" name="nee" />
    <bpmn:sequenceFlow id="Flow_c2_tobe_5" sourceRef="t2" targetRef="p1" />
    <bpmn:sequenceFlow id="Flow_c2_tobe_6" sourceRef="p1" targetRef="t3" />
    <bpmn:sequenceFlow id="Flow_c2_tobe_7" sourceRef="p1" targetRef="t4" />
    <bpmn:sequenceFlow id="Flow_c2_tobe_8" sourceRef="p1" targetRef="t5" name="indien verzekerd" />
    <bpmn:sequenceFlow id="Flow_c2_tobe_9" sourceRef="t3" targetRef="e5" />
    <bpmn:sequenceFlow id="Flow_c2_tobe_10" sourceRef="t5" targetRef="e6" />
    <bpmn:sequenceFlow id="Flow_c2_tobe_11" sourceRef="t4" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_c2_tobe_12" sourceRef="g2" targetRef="t6" name="nee" />
    <bpmn:sequenceFlow id="Flow_c2_tobe_13" sourceRef="t6" targetRef="t4" />
    <bpmn:sequenceFlow id="Flow_c2_tobe_14" sourceRef="g2" targetRef="t7" name="ja" />
    <bpmn:sequenceFlow id="Flow_c2_tobe_15" sourceRef="t7" targetRef="t8" />
    <bpmn:sequenceFlow id="Flow_c2_tobe_16" sourceRef="t8" targetRef="g4" />
    <bpmn:sequenceFlow id="Flow_c2_tobe_17" sourceRef="g4" targetRef="t8" name="volgend niveau" />
    <bpmn:sequenceFlow id="Flow_c2_tobe_18" sourceRef="g4" targetRef="e7" name="afgewezen" />
    <bpmn:sequenceFlow id="Flow_c2_tobe_19" sourceRef="g4" targetRef="t10" name="laatste ok" />
    <bpmn:sequenceFlow id="Flow_c2_tobe_20" sourceRef="t10" targetRef="t11" />
    <bpmn:sequenceFlow id="Flow_c2_tobe_21" sourceRef="t11" targetRef="e1" />
  </bpmn:process>
