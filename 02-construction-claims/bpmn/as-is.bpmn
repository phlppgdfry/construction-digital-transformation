<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_c2_asis" targetNamespace="https://halverdijk.example/bpmn" exporter="construction-digital-transformation/scripts/bpmn.mjs" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_c2_asis">
    <bpmn:documentation>Huidige werkwijze (fictief): meldingen komen via drie kanalen, het dossier leeft in een Excel-register, informatie wordt nagebeld en de verzekeringsaangifte gebeurt vaak te laat.</bpmn:documentation>
    <bpmn:participant id="Pool_c2_asis" name="Halverdijk Aannemingen" processRef="Process_c2_asis" />
  </bpmn:collaboration>
  <bpmn:process id="Process_c2_asis" name="AS-IS — schademelding via telefoon, mail en papier" isExecutable="false">
    <bpmn:laneSet id="LaneSet_c2_asis">
      <bpmn:lane id="Lane_c2_asis_wl" name="Werfleider">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_c2_asis_pl" name="Projectleider">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_c2_asis_adm" name="Administratie / claims">
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_c2_asis_ext" name="Verzekeraar / derden">
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Schade vastgesteld">
      <bpmn:outgoing>Flow_c2_asis_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="t1" name="Bellen, mailen of papier invullen">
      <bpmn:incoming>Flow_c2_asis_1</bpmn:incoming>
      <bpmn:outgoing>Flow_c2_asis_2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="t2" name="Info noteren, foto's vragen">
      <bpmn:incoming>Flow_c2_asis_2</bpmn:incoming>
      <bpmn:outgoing>Flow_c2_asis_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t3" name="Regel aanmaken in Excel-register">
      <bpmn:incoming>Flow_c2_asis_3</bpmn:incoming>
      <bpmn:outgoing>Flow_c2_asis_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g1" name="Info volledig?" default="Flow_c2_asis_7">
      <bpmn:incoming>Flow_c2_asis_4</bpmn:incoming>
      <bpmn:incoming>Flow_c2_asis_6</bpmn:incoming>
      <bpmn:outgoing>Flow_c2_asis_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_c2_asis_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="t4" name="Nabellen, info later doorsturen">
      <bpmn:incoming>Flow_c2_asis_5</bpmn:incoming>
      <bpmn:outgoing>Flow_c2_asis_6</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="g2" name="Verzekering nodig?" default="Flow_c2_asis_9">
      <bpmn:incoming>Flow_c2_asis_7</bpmn:incoming>
      <bpmn:outgoing>Flow_c2_asis_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_c2_asis_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t6" name="Herstel regelen">
      <bpmn:incoming>Flow_c2_asis_9</bpmn:incoming>
      <bpmn:outgoing>Flow_c2_asis_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t5" name="Aangifte opmaken (vaak na deadline)">
      <bpmn:incoming>Flow_c2_asis_8</bpmn:incoming>
      <bpmn:outgoing>Flow_c2_asis_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:receiveTask id="t7" name="Expertise en beslissing verzekeraar">
      <bpmn:incoming>Flow_c2_asis_10</bpmn:incoming>
      <bpmn:outgoing>Flow_c2_asis_11</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="t8" name="Kosten boeken, dossier sluiten">
      <bpmn:incoming>Flow_c2_asis_11</bpmn:incoming>
      <bpmn:incoming>Flow_c2_asis_12</bpmn:incoming>
      <bpmn:outgoing>Flow_c2_asis_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e1" name="Dossier afgesloten">
      <bpmn:incoming>Flow_c2_asis_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_c2_asis_1" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_c2_asis_2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_c2_asis_3" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="Flow_c2_asis_4" sourceRef="t3" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_c2_asis_5" sourceRef="g1" targetRef="t4" name="nee" />
    <bpmn:sequenceFlow id="Flow_c2_asis_6" sourceRef="t4" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_c2_asis_7" sourceRef="g1" targetRef="g2" name="ja" />
    <bpmn:sequenceFlow id="Flow_c2_asis_8" sourceRef="g2" targetRef="t5" name="ja" />
    <bpmn:sequenceFlow id="Flow_c2_asis_9" sourceRef="g2" targetRef="t6" name="nee" />
    <bpmn:sequenceFlow id="Flow_c2_asis_10" sourceRef="t5" targetRef="t7" />
    <bpmn:sequenceFlow id="Flow_c2_asis_11" sourceRef="t7" targetRef="t8" />
    <bpmn:sequenceFlow id="Flow_c2_asis_12" sourceRef="t6" targetRef="t8" />
    <bpmn:sequenceFlow id="Flow_c2_asis_13" sourceRef="t8" targetRef="e1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_c2_asis">
    <bpmndi:BPMNPlane id="Plane_c2_asis" bpmnElement="Collab_c2_asis">
      <bpmndi:BPMNShape id="Pool_c2_asis_di" bpmnElement="Pool_c2_asis" isHorizontal="true"><dc:Bounds x="20" y="20" width="1750" height="520" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_c2_asis_wl_di" bpmnElement="Lane_c2_asis_wl" isHorizontal="true"><dc:Bounds x="50" y="20" width="1720" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_c2_asis_pl_di" bpmnElement="Lane_c2_asis_pl" isHorizontal="true"><dc:Bounds x="50" y="150" width="1720" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_c2_asis_adm_di" bpmnElement="Lane_c2_asis_adm" isHorizontal="true"><dc:Bounds x="50" y="280" width="1720" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_c2_asis_ext_di" bpmnElement="Lane_c2_asis_ext" isHorizontal="true"><dc:Bounds x="50" y="410" width="1720" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s1_di" bpmnElement="s1"><dc:Bounds x="132" y="67" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="100" y="107" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t1_di" bpmnElement="t1"><dc:Bounds x="242" y="51" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t2_di" bpmnElement="t2"><dc:Bounds x="392" y="181" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t3_di" bpmnElement="t3"><dc:Bounds x="542" y="311" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g1_di" bpmnElement="g1" isMarkerVisible="true"><dc:Bounds x="725" y="320" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="700" y="374" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t4_di" bpmnElement="t4"><dc:Bounds x="842" y="51" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g2_di" bpmnElement="g2" isMarkerVisible="true"><dc:Bounds x="1025" y="320" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1000" y="374" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t6_di" bpmnElement="t6"><dc:Bounds x="1142" y="181" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t5_di" bpmnElement="t5"><dc:Bounds x="1142" y="441" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t7_di" bpmnElement="t7"><dc:Bounds x="1292" y="441" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t8_di" bpmnElement="t8"><dc:Bounds x="1442" y="311" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e1_di" bpmnElement="e1"><dc:Bounds x="1632" y="327" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1600" y="367" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_c2_asis_1_di" bpmnElement="Flow_c2_asis_1"><di:waypoint x="168" y="85" /><di:waypoint x="242" y="85" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_c2_asis_2_di" bpmnElement="Flow_c2_asis_2"><di:waypoint x="300" y="119" /><di:waypoint x="300" y="215" /><di:waypoint x="392" y="215" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_c2_asis_3_di" bpmnElement="Flow_c2_asis_3"><di:waypoint x="450" y="249" /><di:waypoint x="450" y="345" /><di:waypoint x="542" y="345" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_c2_asis_4_di" bpmnElement="Flow_c2_asis_4"><di:waypoint x="658" y="345" /><di:waypoint x="725" y="345" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_c2_asis_5_di" bpmnElement="Flow_c2_asis_5"><di:waypoint x="750" y="320" /><di:waypoint x="750" y="85" /><di:waypoint x="842" y="85" /><bpmndi:BPMNLabel><dc:Bounds x="756" y="67" width="40" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_c2_asis_6_di" bpmnElement="Flow_c2_asis_6"><di:waypoint x="900" y="119" /><di:waypoint x="900" y="398" /><di:waypoint x="750" y="398" /><di:waypoint x="750" y="370" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_c2_asis_7_di" bpmnElement="Flow_c2_asis_7"><di:waypoint x="775" y="345" /><di:waypoint x="1025" y="345" /><bpmndi:BPMNLabel><dc:Bounds x="781" y="327" width="40" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_c2_asis_8_di" bpmnElement="Flow_c2_asis_8"><di:waypoint x="1050" y="370" /><di:waypoint x="1050" y="475" /><di:waypoint x="1142" y="475" /><bpmndi:BPMNLabel><dc:Bounds x="1056" y="457" width="40" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_c2_asis_9_di" bpmnElement="Flow_c2_asis_9"><di:waypoint x="1050" y="320" /><di:waypoint x="1050" y="215" /><di:waypoint x="1142" y="215" /><bpmndi:BPMNLabel><dc:Bounds x="1056" y="197" width="40" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_c2_asis_10_di" bpmnElement="Flow_c2_asis_10"><di:waypoint x="1258" y="475" /><di:waypoint x="1292" y="475" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_c2_asis_11_di" bpmnElement="Flow_c2_asis_11"><di:waypoint x="1350" y="441" /><di:waypoint x="1350" y="345" /><di:waypoint x="1442" y="345" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_c2_asis_12_di" bpmnElement="Flow_c2_asis_12"><di:waypoint x="1200" y="249" /><di:waypoint x="1200" y="345" /><di:waypoint x="1442" y="345" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_c2_asis_13_di" bpmnElement="Flow_c2_asis_13"><di:waypoint x="1558" y="345" /><di:waypoint x="1632" y="345" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
