      <bpmndi:BPMNShape id="t8_di" bpmnElement="t8"><dc:Bounds x="1292" y="441" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t9_di" bpmnElement="t9"><dc:Bounds x="1442" y="571" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t12_di" bpmnElement="t12"><dc:Bounds x="1592" y="51" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t13_di" bpmnElement="t13"><dc:Bounds x="1742" y="701" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e1_di" bpmnElement="e1"><dc:Bounds x="1932" y="717" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1900" y="757" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_c3_tobe_1_di" bpmnElement="Flow_c3_tobe_1"><di:waypoint x="168" y="85" /><di:waypoint x="242" y="85" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_c3_tobe_2_di" bpmnElement="Flow_c3_tobe_2"><di:waypoint x="300" y="119" /><di:waypoint x="300" y="215" /><di:waypoint x="392" y="215" /></bpmndi:BPMNEdge>
