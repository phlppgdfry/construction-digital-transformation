<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_c3_tobe" targetNamespace="https://halverdijk.example/bpmn" exporter="construction-digital-transformation/scripts/bpmn.mjs" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_c3_tobe">
    <bpmn:documentation>Gewenste werkwijze: aanvraag in de app, voorraad per depot via API, beslistabel DT-03 bepaalt of er goedkeuring nodig is. Reservatie en aankoopaanvraag gaan via een outbox met retry naar het ERP, en de ontvangst wordt op de werf bevestigd.</bpmn:documentation>
    <bpmn:participant id="Pool_c3_tobe" name="Halverdijk Group" processRef="Process_c3_tobe" />
  </bpmn:collaboration>
  <bpmn:process id="Process_c3_tobe" name="TO-BE — digitale materiaalaanvraag met voorraadcheck en ERP-koppeling" isExecutable="false">
    <bpmn:laneSet id="LaneSet_c3_tobe">
      <bpmn:lane id="Lane_c3_tobe_wl" name="Werfleider (app)">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t12</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_c3_tobe_flow" name="Power Automate + regels">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_c3_tobe_appr" name="Projectleider / afdeling">
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_c3_tobe_buy" name="Aankoop">
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_c3_tobe_plan" name="Werf- en transport-planning">
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_c3_tobe_erp" name="ERP (via API-laag)">
        <bpmn:flowNodeRef>t13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Materiaal nodig (bij voorkeur in weekplanning)">
      <bpmn:outgoing>Flow_c3_tobe_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="t1" name="Aanvraag: werf, artikel, hoeveelheid, datum">
      <bpmn:incoming>Flow_c3_tobe_1</bpmn:incoming>
      <bpmn:outgoing>Flow_c3_tobe_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t2" name="Voorraad per depot opvragen (API)">
      <bpmn:incoming>Flow_c3_tobe_2</bpmn:incoming>
      <bpmn:outgoing>Flow_c3_tobe_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="t3" name="Toewijzen, budget, spoed, route (DT-03)">
      <bpmn:incoming>Flow_c3_tobe_3</bpmn:incoming>
      <bpmn:outgoing>Flow_c3_tobe_4</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="g1" name="Goedkeuring nodig?" default="Flow_c3_tobe_5">
      <bpmn:incoming>Flow_c3_tobe_4</bpmn:incoming>
      <bpmn:outgoing>Flow_c3_tobe_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_c3_tobe_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t4" name="Goedkeuren in Teams of app">
      <bpmn:incoming>Flow_c3_tobe_6</bpmn:incoming>
      <bpmn:outgoing>Flow_c3_tobe_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g3" name="Goedgekeurd?" default="Flow_c3_tobe_9">
      <bpmn:incoming>Flow_c3_tobe_7</bpmn:incoming>
      <bpmn:outgoing>Flow_c3_tobe_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_c3_tobe_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e2" name="Afgewezen, werfleider verwittigd">
      <bpmn:incoming>Flow_c3_tobe_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t6" name="Reservatie + aankoopaanvraag naar ERP (outbox, retry)">
      <bpmn:incoming>Flow_c3_tobe_5</bpmn:incoming>
      <bpmn:incoming>Flow_c3_tobe_9</bpmn:incoming>
      <bpmn:outgoing>Flow_c3_tobe_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g4" name="Aankoop nodig?" default="Flow_c3_tobe_12">
      <bpmn:incoming>Flow_c3_tobe_10</bpmn:incoming>
      <bpmn:outgoing>Flow_c3_tobe_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_c3_tobe_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t8" name="Bestelling plaatsen bij leverancier">
      <bpmn:incoming>Flow_c3_tobe_11</bpmn:incoming>
      <bpmn:outgoing>Flow_c3_tobe_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t9" name="Levering inplannen (depot of leverancier)">
      <bpmn:incoming>Flow_c3_tobe_12</bpmn:incoming>
      <bpmn:incoming>Flow_c3_tobe_13</bpmn:incoming>
      <bpmn:outgoing>Flow_c3_tobe_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t12" name="Ontvangst bevestigen (foto leverbon)">
      <bpmn:incoming>Flow_c3_tobe_14</bpmn:incoming>
      <bpmn:outgoing>Flow_c3_tobe_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t13" name="Verbruik boeken op werf (ERP)">
      <bpmn:incoming>Flow_c3_tobe_15</bpmn:incoming>
      <bpmn:outgoing>Flow_c3_tobe_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e1" name="Kosten op project, dezelfde dag">
      <bpmn:incoming>Flow_c3_tobe_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_c3_tobe_1" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_c3_tobe_2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_c3_tobe_3" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="Flow_c3_tobe_4" sourceRef="t3" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_c3_tobe_5" sourceRef="g1" targetRef="t6" name="nee (DT-03.4)" />
    <bpmn:sequenceFlow id="Flow_c3_tobe_6" sourceRef="g1" targetRef="t4" name="ja" />
    <bpmn:sequenceFlow id="Flow_c3_tobe_7" sourceRef="t4" targetRef="g3" />
    <bpmn:sequenceFlow id="Flow_c3_tobe_8" sourceRef="g3" targetRef="e2" name="nee" />
    <bpmn:sequenceFlow id="Flow_c3_tobe_9" sourceRef="g3" targetRef="t6" name="ja" />
    <bpmn:sequenceFlow id="Flow_c3_tobe_10" sourceRef="t6" targetRef="g4" />
    <bpmn:sequenceFlow id="Flow_c3_tobe_11" sourceRef="g4" targetRef="t8" name="ja" />
    <bpmn:sequenceFlow id="Flow_c3_tobe_12" sourceRef="g4" targetRef="t9" name="nee" />
    <bpmn:sequenceFlow id="Flow_c3_tobe_13" sourceRef="t8" targetRef="t9" />
    <bpmn:sequenceFlow id="Flow_c3_tobe_14" sourceRef="t9" targetRef="t12" />
    <bpmn:sequenceFlow id="Flow_c3_tobe_15" sourceRef="t12" targetRef="t13" />
    <bpmn:sequenceFlow id="Flow_c3_tobe_16" sourceRef="t13" targetRef="e1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_c3_tobe">
    <bpmndi:BPMNPlane id="Plane_c3_tobe" bpmnElement="Collab_c3_tobe">
      <bpmndi:BPMNShape id="Pool_c3_tobe_di" bpmnElement="Pool_c3_tobe" isHorizontal="true"><dc:Bounds x="20" y="20" width="2050" height="780" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_c3_tobe_wl_di" bpmnElement="Lane_c3_tobe_wl" isHorizontal="true"><dc:Bounds x="50" y="20" width="2020" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_c3_tobe_flow_di" bpmnElement="Lane_c3_tobe_flow" isHorizontal="true"><dc:Bounds x="50" y="150" width="2020" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_c3_tobe_appr_di" bpmnElement="Lane_c3_tobe_appr" isHorizontal="true"><dc:Bounds x="50" y="280" width="2020" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_c3_tobe_buy_di" bpmnElement="Lane_c3_tobe_buy" isHorizontal="true"><dc:Bounds x="50" y="410" width="2020" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_c3_tobe_plan_di" bpmnElement="Lane_c3_tobe_plan" isHorizontal="true"><dc:Bounds x="50" y="540" width="2020" height="130" /></bpmndi:BPMNShape>
