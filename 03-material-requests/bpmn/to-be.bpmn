      <bpmndi:BPMNEdge id="Flow_c3_tobe_6_di" bpmnElement="Flow_c3_tobe_6"><di:waypoint x="750" y="240" /><di:waypoint x="750" y="345" /><di:waypoint x="842" y="345" /><bpmndi:BPMNLabel><dc:Bounds x="756" y="327" width="40" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
