      <bpmndi:BPMNShape id="e2_di" bpmnElement="e2"><dc:Bounds x="1182" y="327" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1150" y="367" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
