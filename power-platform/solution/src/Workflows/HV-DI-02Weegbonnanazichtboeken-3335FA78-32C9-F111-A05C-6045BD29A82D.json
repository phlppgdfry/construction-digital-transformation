{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "hv_dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      },
      "shared_approvals": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "hv_approvals"
        },
        "api": {
          "name": "shared_approvals"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "Weegbon_goedgekeurd": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "subscriptionRequest/message": 3,
              "subscriptionRequest/entityname": "hv_document",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filteringattributes": "hv_status",
              "subscriptionRequest/filterexpression": "hv_status eq 100000006"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "actions": {
        "Materiaalcode": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "hv_materiaalcodes",
              "$filter": "hv_code eq '@{triggerOutputs()?['body/hv_materiaal']}'",
              "$top": 1
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {}
        },
        "Al_geboekt": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "hv_documents",
              "$filter": "hv_bonnummer eq '@{triggerOutputs()?['body/hv_bonnummer']}' and hv_documentid ne @{triggerOutputs()?['body/hv_documentid']} and hv_status eq 100000004",
              "$top": 1
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {}
        },
        "Controle": {
          "type": "Compose",
          "inputs": "@if(greater(length(outputs('Al_geboekt')?['body/value']), 0), 'dubbel', if(or(equals(length(outputs('Materiaalcode')?['body/value']), 0), and(equals(triggerOutputs()?['body/hv_richting'], 100000000), not(equals(first(outputs('Materiaalcode')?['body/value'])?['hv_soort'], 100000000))), and(not(equals(triggerOutputs()?['body/hv_richting'], 100000000)), not(equals(first(outputs('Materiaalcode')?['body/value'])?['hv_soort'], 100000002)))), 'geweigerd', 'ok'))",
          "runAfter": {
            "Materiaalcode": [
              "Succeeded"
            ],
            "Al_geboekt": [
              "Succeeded"
            ]
          }
        },
        "Volgens_controle": {
          "type": "Switch",
          "runAfter": {
            "Controle": [
              "Succeeded"
            ]
          },
          "expression": "@outputs('Controle')",
          "cases": {
            "Dubbel": {
              "case": "dubbel",
              "actions": {
                "Status_dubbel": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "UpdateOnlyRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "hv_documents",
                      "recordId": "@triggerOutputs()?['body/hv_documentid']",
                      "item/hv_status": 100000005,
                      "item/hv_reviewopmerking": "@{concat(coalesce(triggerOutputs()?['body/hv_reviewopmerking'], ''), ' | Server: bonnummer al geboekt, niet opnieuw geboekt.')}"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {}
                }
              }
            },
            "Geweigerd": {
              "case": "geweigerd",
              "actions": {
                "Status_escalatie": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "UpdateOnlyRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "hv_documents",
                      "recordId": "@triggerOutputs()?['body/hv_documentid']",
                      "item/hv_status": 100000003,
                      "item/hv_reviewopmerking": "@{concat(coalesce(triggerOutputs()?['body/hv_reviewopmerking'], ''), ' | Server: materiaal niet toegelaten, terug naar escalatie.')}"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {}
                }
              }
            },
            "Boeken": {
              "case": "ok",
              "actions": {
                "ERP_boeking": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "CreateRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "hv_erpboekings",
                      "item/hv_idempotencykey": "wb-@{triggerOutputs()?['body/hv_bonnummer']}",
                      "item/hv_soort": 100000000,
                      "item/hv_referentie": "@triggerOutputs()?['body/hv_documentnr']",
                      "item/hv_bedrag": "@mul(div(float(triggerOutputs()?['body/hv_netto']), 1000), float(coalesce(first(outputs('Materiaalcode')?['body/value'])?['hv_prijsperton'], 0)))",
                      "item/hv_payload": "@{concat('{\"weighingTicket\":\"', triggerOutputs()?['body/hv_bonnummer'], '\",\"netKg\":', string(triggerOutputs()?['body/hv_netto']), ',\"approvedBy\":\"', coalesce(triggerOutputs()?['body/hv_reviewer'], 'reviewer'), '\"}')}"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {}
                },
                "Status_geboekt": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "UpdateOnlyRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "hv_documents",
                      "recordId": "@triggerOutputs()?['body/hv_documentid']",
                      "item/hv_status": 100000004,
                      "item/hv_erpreferentie": "@{if(equals(actions('ERP_boeking')?['status'], 'Succeeded'), concat('wb-', triggerOutputs()?['body/hv_bonnummer']), concat('wb-', triggerOutputs()?['body/hv_bonnummer'], ' (al geboekt, idempotent)'))}"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {
                    "ERP_boeking": [
                      "Succeeded",
                      "Failed",
                      "Skipped",
                      "TimedOut"
                    ]
                  }
                }
              }
            }
          },
          "default": {
            "actions": {}
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}