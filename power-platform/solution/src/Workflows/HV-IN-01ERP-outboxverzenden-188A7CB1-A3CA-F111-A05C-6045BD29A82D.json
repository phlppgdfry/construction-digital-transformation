{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "hv_dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      },
      "shared_approvals": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "hv_approvals"
        },
        "api": {
          "name": "shared_approvals"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "ERP-sandbox bereikbaar (hv_ErpBeschikbaar)": {
          "defaultValue": true,
          "type": "Bool",
          "metadata": {
            "schemaName": "hv_ErpBeschikbaar"
          }
        }
      },
      "triggers": {
        "Elke_5_minuten": {
          "type": "Recurrence",
          "recurrence": {
            "frequency": "Minute",
            "interval": 5
          },
          "runtimeConfiguration": {
            "concurrency": {
              "runs": 1
            }
          }
        }
      },
      "actions": {
        "Probeer": {
          "type": "Scope",
          "actions": {
            "Klaar": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "hv_outboxes",
                  "$filter": "hv_status eq 100000000 and hv_volgendepoging le @{utcNow()}",
                  "$orderby": "createdon asc",
                  "$top": 50
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "Per_bericht": {
              "type": "Foreach",
              "foreach": "@outputs('Klaar')?['body/value']",
              "runAfter": {
                "Klaar": [
                  "Succeeded"
                ]
              },
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 1
                }
              },
              "actions": {
                "ERP_bereikbaar": {
                  "type": "If",
                  "runAfter": {},
                  "expression": {
                    "equals": [
                      "@parameters('ERP-sandbox bereikbaar (hv_ErpBeschikbaar)')",
                      true
                    ]
                  },
                  "actions": {
                    "ERP_boeking": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_commondataserviceforapps",
                          "operationId": "CreateRecord",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                        },
                        "parameters": {
                          "entityName": "hv_erpboekings",
                          "item/hv_idempotencykey": "@items('Per_bericht')?['hv_idempotencykey']",
                          "item/hv_soort": "@items('Per_bericht')?['hv_endpoint']",
                          "item/hv_payload": "@items('Per_bericht')?['hv_body']",
                          "item/hv_referentie": "@items('Per_bericht')?['hv_referentie']",
                          "item/hv_bedrag": "@float(coalesce(json(items('Per_bericht')?['hv_body'])?['bedrag'], 0))"
                        },
                        "authentication": "@parameters('$authentication')"
                      },
                      "runAfter": {}
                    },
                    "Reservatie": {
                      "type": "If",
                      "runAfter": {
                        "ERP_boeking": [
                          "Succeeded"
                        ]
                      },
                      "expression": {
                        "equals": [
                          "@items('Per_bericht')?['hv_endpoint']",
                          100000001
                        ]
                      },
                      "actions": {
                        "Voorraad": {
                          "type": "OpenApiConnection",
                          "inputs": {
                            "host": {
                              "connectionName": "shared_commondataserviceforapps",
                              "operationId": "ListRecords",
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                            },
                            "parameters": {
                              "entityName": "hv_voorraads",
                              "$filter": "hv_naam eq '@{json(items('Per_bericht')?['hv_body'])?['voorraad']}'",
                              "$top": 1
                            },
                            "authentication": "@parameters('$authentication')"
                          },
                          "runAfter": {}
                        },
                        "Reserveren": {
                          "type": "OpenApiConnection",
                          "inputs": {
                            "host": {
                              "connectionName": "shared_commondataserviceforapps",
                              "operationId": "UpdateOnlyRecord",
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                            },
                            "parameters": {
                              "entityName": "hv_voorraads",
                              "recordId": "@first(outputs('Voorraad')?['body/value'])?['hv_voorraadid']",
                              "item/hv_gereserveerd": "@add(float(coalesce(first(outputs('Voorraad')?['body/value'])?['hv_gereserveerd'], 0)), float(json(items('Per_bericht')?['hv_body'])?['hoeveelheid']))"
                            },
                            "authentication": "@parameters('$authentication')"
                          },
                          "runAfter": {
                            "Voorraad": [
                              "Succeeded"
                            ]
                          }
                        }
                      },
                      "else": {
                        "actions": {}
                      }
                    },
                    "Verzonden": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_commondataserviceforapps",
                          "operationId": "UpdateOnlyRecord",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                        },
                        "parameters": {
                          "entityName": "hv_outboxes",
                          "recordId": "@items('Per_bericht')?['hv_outboxid']",
                          "item/hv_status": 100000001,
                          "item/hv_pogingen": "@add(coalesce(items('Per_bericht')?['hv_pogingen'], 0), 1)",
                          "item/hv_laatstefout": "@{if(equals(actions('ERP_boeking')?['status'], 'Succeeded'), '201 geboekt', '200 al geboekt (idempotent)')}"
                        },
                        "authentication": "@parameters('$authentication')"
                      },
                      "runAfter": {
                        "Reservatie": [
                          "Succeeded",
                          "Failed",
                          "Skipped",
                          "TimedOut"
                        ]
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "Nog_pogingen": {
                        "type": "If",
                        "runAfter": {},
                        "expression": {
                          "less": [
                            "@coalesce(items('Per_bericht')?['hv_pogingen'], 0)",
                            5
                          ]
                        },
                        "actions": {
                          "Opnieuw_plannen": {
                            "type": "OpenApiConnection",
                            "inputs": {
                              "host": {
                                "connectionName": "shared_commondataserviceforapps",
                                "operationId": "UpdateOnlyRecord",
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                              },
                              "parameters": {
                                "entityName": "hv_outboxes",
                                "recordId": "@items('Per_bericht')?['hv_outboxid']",
                                "item/hv_pogingen": "@add(coalesce(items('Per_bericht')?['hv_pogingen'], 0), 1)",
                                "item/hv_volgendepoging": "@addMinutes(utcNow(), createArray(1, 5, 15, 60, 240)[coalesce(items('Per_bericht')?['hv_pogingen'], 0)])",
                                "item/hv_laatstefout": "503 ERP niet bereikbaar (sandbox uitgeschakeld via hv_ErpBeschikbaar)"
                              },
                              "authentication": "@parameters('$authentication')"
                            },
                            "runAfter": {}
                          }
                        },
                        "else": {
                          "actions": {
                            "Dead_letter": {
                              "type": "OpenApiConnection",
                              "inputs": {
                                "host": {
                                  "connectionName": "shared_commondataserviceforapps",
                                  "operationId": "UpdateOnlyRecord",
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                                },
                                "parameters": {
                                  "entityName": "hv_outboxes",
                                  "recordId": "@items('Per_bericht')?['hv_outboxid']",
                                  "item/hv_status": 100000009,
                                  "item/hv_pogingen": "@add(coalesce(items('Per_bericht')?['hv_pogingen'], 0), 1)",
                                  "item/hv_laatstefout": "Dead-letter na 6 pogingen — functioneel beheer verwittigd (runbook)"
                                },
                                "authentication": "@parameters('$authentication')"
                              },
                              "runAfter": {}
                            },
                            "Melding_dead_letter": {
                              "type": "OpenApiConnection",
                              "inputs": {
                                "host": {
                                  "connectionName": "shared_commondataserviceforapps",
                                  "operationId": "CreateRecord",
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                                },
                                "parameters": {
                                  "entityName": "hv_meldings",
                                  "item/hv_titel": "@{concat('ERP-bericht in dead-letter: ', items('Per_bericht')?['hv_idempotencykey'])}",
                                  "item/hv_tekst": "@{concat('Zes pogingen mislukt voor ', items('Per_bericht')?['hv_referentie'], '. Volg het runbook: oorzaak herstellen, daarna status op Wachtend en pogingen op 0.')}",
                                  "item/hv_rol": "Functioneel beheer",
                                  "item/hv_soort": 100000003,
                                  "item/hv_kanaal": 100000000,
                                  "item/hv_status": 100000000,
                                  "item/hv_bron": "HV-IN-01",
                                  "item/hv_referentie": "@items('Per_bericht')?['hv_referentie']",
                                  "item/hv_link": "@{concat('/main.aspx?pagetype=entityrecord&etn=hv_outbox&id=', items('Per_bericht')?['hv_outboxid'])}"
                                },
                                "authentication": "@parameters('$authentication')"
                              },
                              "runAfter": {
                                "Dead_letter": [
                                  "Succeeded"
                                ]
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "runAfter": {}
        },
        "Bij_fout": {
          "type": "Scope",
          "runAfter": {
            "Probeer": [
              "Failed",
              "TimedOut"
            ]
          },
          "actions": {
            "Mislukte_stappen": {
              "type": "Query",
              "inputs": {
                "from": "@result('Probeer')",
                "where": "@equals(item()?['status'], 'Failed')"
              },
              "runAfter": {}
            },
            "Foutnamen": {
              "type": "Select",
              "inputs": {
                "from": "@body('Mislukte_stappen')",
                "select": "@item()?['name']"
              },
              "runAfter": {
                "Mislukte_stappen": [
                  "Succeeded"
                ]
              }
            },
            "Foutmelding": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "hv_meldings",
                  "item/hv_titel": "@{concat('HV-IN-01 mislukt', if(empty(string('')), '', concat(' · ', string(''))))}",
                  "item/hv_tekst": "@{concat('Mislukte stap: ', join(body('Foutnamen'), ', '), '. ', coalesce(first(body('Mislukte_stappen'))?['error']?['message'], ''))}",
                  "item/hv_rol": "Functioneel beheer",
                  "item/hv_soort": 100000003,
                  "item/hv_kanaal": 100000000,
                  "item/hv_status": 100000000,
                  "item/hv_bron": "HV-IN-01",
                  "item/hv_referentie": "@{string('')}",
                  "item/hv_link": "@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Foutnamen": [
                  "Succeeded"
                ]
              }
            },
            "Run_mislukt": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "HV-FOUT",
                  "message": "Zie de Fout-melding in de backoffice (Beheer › Meldingen)."
                }
              },
              "runAfter": {
                "Foutmelding": [
                  "Succeeded"
                ]
              }
            }
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}