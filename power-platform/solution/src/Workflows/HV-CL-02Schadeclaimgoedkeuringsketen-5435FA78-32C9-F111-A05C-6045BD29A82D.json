{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "hv_dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      },
      "shared_approvals": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "hv_approvals"
        },
        "api": {
          "name": "shared_approvals"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "Ter_goedkeuring": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "subscriptionRequest/message": 3,
              "subscriptionRequest/entityname": "hv_schadeclaim",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filteringattributes": "hv_status",
              "subscriptionRequest/filterexpression": "hv_status eq 100000003"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "actions": {
        "Keten": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "keten",
                "type": "array",
                "value": "@split(triggerOutputs()?['body/hv_goedkeuringsketen'], '>')"
              }
            ]
          },
          "runAfter": {}
        },
        "Niveau": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "niveau",
                "type": "integer",
                "value": 0
              }
            ]
          },
          "runAfter": {
            "Keten": [
              "Succeeded"
            ]
          }
        },
        "Afgewezen": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "afgewezen",
                "type": "boolean",
                "value": false
              }
            ]
          },
          "runAfter": {
            "Niveau": [
              "Succeeded"
            ]
          }
        },
        "Per_niveau": {
          "type": "Until",
          "runAfter": {
            "Afgewezen": [
              "Succeeded"
            ]
          },
          "expression": "@or(variables('afgewezen'), greaterOrEquals(variables('niveau'), length(variables('keten'))))",
          "limit": {
            "count": 6,
            "timeout": "P14D"
          },
          "actions": {
            "Goedkeurder": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "hv_goedkeurders",
                  "$filter": "hv_rol eq '@{variables('keten')[variables('niveau')]}'",
                  "$top": 1
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "Goedkeuring": {
              "type": "OpenApiConnectionWebhook",
              "inputs": {
                "host": {
                  "connectionName": "shared_approvals",
                  "operationId": "StartAndWaitForAnApproval",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_approvals"
                },
                "parameters": {
                  "approvalType": "Basic",
                  "WebhookApprovalCreationInput/title": "Schadeclaim @{triggerOutputs()?['body/hv_dossiernummer']} — niveau @{add(variables('niveau'), 1)}/@{length(variables('keten'))}: @{variables('keten')[variables('niveau')]}",
                  "WebhookApprovalCreationInput/assignedTo": "@{first(outputs('Goedkeurder')?['body/value'])?['hv_email']}",
                  "WebhookApprovalCreationInput/details": "Raming €@{triggerOutputs()?['body/hv_geschatbedrag']} · @{triggerOutputs()?['body/hv_omschrijving']} · keten @{triggerOutputs()?['body/hv_goedkeuringsketen']}",
                  "WebhookApprovalCreationInput/enableNotifications": true,
                  "WebhookApprovalCreationInput/enableReassignment": true
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Goedkeurder": [
                  "Succeeded"
                ]
              }
            },
            "Tijdlijn": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "hv_tijdlijns",
                  "item/hv_gebeurtenis": "@{if(equals(body('Goedkeuring')?['outcome'], 'Approve'), 'goedgekeurd', 'afgewezen')} (@{variables('keten')[variables('niveau')]})",
                  "item/hv_door": "@{first(body('Goedkeuring')?['responses'])?['responder/email']}",
                  "item/hv_opmerking": "@{first(body('Goedkeuring')?['responses'])?['comments']}",
                  "item/hv_Schadeclaim@odata.bind": "/hv_schadeclaims(@{triggerOutputs()?['body/hv_schadeclaimid']})"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Goedkeuring": [
                  "Succeeded"
                ]
              }
            },
            "Uitkomst": {
              "type": "If",
              "runAfter": {
                "Tijdlijn": [
                  "Succeeded"
                ]
              },
              "expression": {
                "equals": [
                  "@body('Goedkeuring')?['outcome']",
                  "Approve"
                ]
              },
              "actions": {
                "Volgend_niveau": {
                  "type": "IncrementVariable",
                  "inputs": {
                    "name": "niveau",
                    "value": 1
                  },
                  "runAfter": {}
                },
                "Niveau_bewaren": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "UpdateOnlyRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "hv_schadeclaims",
                      "recordId": "@triggerOutputs()?['body/hv_schadeclaimid']",
                      "item/hv_goedkeuringsniveau": "@variables('niveau')"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {
                    "Volgend_niveau": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {
                  "Markeer_afgewezen": {
                    "type": "SetVariable",
                    "inputs": {
                      "name": "afgewezen",
                      "value": true
                    },
                    "runAfter": {}
                  }
                }
              }
            }
          }
        },
        "Eindstatus": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "UpdateOnlyRecord",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "hv_schadeclaims",
              "recordId": "@triggerOutputs()?['body/hv_schadeclaimid']",
              "item/hv_status": "@if(variables('afgewezen'), 100000005, 100000004)"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Per_niveau": [
              "Succeeded"
            ]
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}