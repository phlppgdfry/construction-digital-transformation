              "item/hv_deadlineverzekeraar": "@if(or(greaterOrEquals(float(coalesce(triggerOutputs()?['body/hv_geschatbedrag'], 0)), float(parameters('Drempel verzekeringsaangifte schade (€) (hv_InsurerThreshold)'))), equals(triggerOutputs()?['body/hv_categorie'], 100000002), equals(triggerOutputs()?['body/hv_categorie'], 100000003), equals(triggerOutputs()?['body/hv_derdebetrokken'], true)), addDays(coalesce(triggerOutputs()?['body/hv_tijdstipschade'], utcNow()), 8), null)"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
