<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_c1_asis" targetNamespace="https://halverdijk.example/bpmn" exporter="construction-digital-transformation/scripts/bpmn.mjs" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_c1_asis">
    <bpmn:documentation>Huidige werkwijze (fictief): papieren weegbonnen worden gebundeld, gescand en overgetypt. Fouten worden pas bij facturatie of een klantklacht zichtbaar.</bpmn:documentation>
    <bpmn:participant id="Pool_c1_asis" name="Halverdijk Recycling" processRef="Process_c1_asis" />
  </bpmn:collaboration>
  <bpmn:process id="Process_c1_asis" name="AS-IS — weegbonnen manueel verwerken" isExecutable="false">
    <bpmn:laneSet id="LaneSet_c1_asis">
      <bpmn:lane id="Lane_c1_asis_drv" name="Chauffeur / vervoerder">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_c1_asis_wb" name="Weegbrugoperator">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_c1_asis_adm" name="Administratie recyclage">
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_c1_asis_fin" name="Facturatie">
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Vrachtwagen aan weegbrug">
      <bpmn:outgoing>Flow_c1_asis_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="t1" name="Wegen en papieren weegbon printen">
      <bpmn:incoming>Flow_c1_asis_1</bpmn:incoming>
      <bpmn:outgoing>Flow_c1_asis_2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="t2" name="Bon aftekenen, kopie mee">
      <bpmn:incoming>Flow_c1_asis_2</bpmn:incoming>
      <bpmn:outgoing>Flow_c1_asis_3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="t3" name="Bonnen 's avonds bundelen en scannen">
      <bpmn:incoming>Flow_c1_asis_3</bpmn:incoming>
      <bpmn:outgoing>Flow_c1_asis_4</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="t4" name="Bon overtypen in ERP">
      <bpmn:documentation>Gemiddeld 3,5 minuten per bon (aanname). Geen controle op dubbele bonnen.</bpmn:documentation>
      <bpmn:incoming>Flow_c1_asis_4</bpmn:incoming>
      <bpmn:incoming>Flow_c1_asis_8</bpmn:incoming>
      <bpmn:outgoing>Flow_c1_asis_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g1" name="Compleet en leesbaar?" default="Flow_c1_asis_7">
      <bpmn:incoming>Flow_c1_asis_5</bpmn:incoming>
      <bpmn:outgoing>Flow_c1_asis_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_c1_asis_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="t5" name="Ontbrekende info opzoeken of navragen">
      <bpmn:incoming>Flow_c1_asis_6</bpmn:incoming>
      <bpmn:outgoing>Flow_c1_asis_8</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="t6" name="Klant, materiaal en prijs nakijken">
      <bpmn:incoming>Flow_c1_asis_7</bpmn:incoming>
      <bpmn:outgoing>Flow_c1_asis_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t7" name="Maandelijks factureren">
      <bpmn:incoming>Flow_c1_asis_9</bpmn:incoming>
      <bpmn:incoming>Flow_c1_asis_13</bpmn:incoming>
      <bpmn:outgoing>Flow_c1_asis_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g2" name="Klant betwist factuur?" default="Flow_c1_asis_12">
      <bpmn:incoming>Flow_c1_asis_10</bpmn:incoming>
      <bpmn:outgoing>Flow_c1_asis_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_c1_asis_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t8" name="Fout zoeken en creditnota">
      <bpmn:incoming>Flow_c1_asis_11</bpmn:incoming>
      <bpmn:outgoing>Flow_c1_asis_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e1" name="Gefactureerd">
      <bpmn:incoming>Flow_c1_asis_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_c1_asis_1" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_c1_asis_2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_c1_asis_3" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="Flow_c1_asis_4" sourceRef="t3" targetRef="t4" />
    <bpmn:sequenceFlow id="Flow_c1_asis_5" sourceRef="t4" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_c1_asis_6" sourceRef="g1" targetRef="t5" name="nee" />
    <bpmn:sequenceFlow id="Flow_c1_asis_7" sourceRef="g1" targetRef="t6" name="ja" />
    <bpmn:sequenceFlow id="Flow_c1_asis_8" sourceRef="t5" targetRef="t4" />
    <bpmn:sequenceFlow id="Flow_c1_asis_9" sourceRef="t6" targetRef="t7" />
    <bpmn:sequenceFlow id="Flow_c1_asis_10" sourceRef="t7" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_c1_asis_11" sourceRef="g2" targetRef="t8" name="ja" />
    <bpmn:sequenceFlow id="Flow_c1_asis_12" sourceRef="g2" targetRef="e1" name="nee" />
    <bpmn:sequenceFlow id="Flow_c1_asis_13" sourceRef="t8" targetRef="t7" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_c1_asis">
    <bpmndi:BPMNPlane id="Plane_c1_asis" bpmnElement="Collab_c1_asis">
      <bpmndi:BPMNShape id="Pool_c1_asis_di" bpmnElement="Pool_c1_asis" isHorizontal="true"><dc:Bounds x="20" y="20" width="1900" height="520" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_c1_asis_drv_di" bpmnElement="Lane_c1_asis_drv" isHorizontal="true"><dc:Bounds x="50" y="20" width="1870" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_c1_asis_wb_di" bpmnElement="Lane_c1_asis_wb" isHorizontal="true"><dc:Bounds x="50" y="150" width="1870" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_c1_asis_adm_di" bpmnElement="Lane_c1_asis_adm" isHorizontal="true"><dc:Bounds x="50" y="280" width="1870" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_c1_asis_fin_di" bpmnElement="Lane_c1_asis_fin" isHorizontal="true"><dc:Bounds x="50" y="410" width="1870" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s1_di" bpmnElement="s1"><dc:Bounds x="132" y="197" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="100" y="237" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t1_di" bpmnElement="t1"><dc:Bounds x="242" y="181" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t2_di" bpmnElement="t2"><dc:Bounds x="392" y="51" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t3_di" bpmnElement="t3"><dc:Bounds x="542" y="181" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t4_di" bpmnElement="t4"><dc:Bounds x="692" y="311" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g1_di" bpmnElement="g1" isMarkerVisible="true"><dc:Bounds x="875" y="320" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="850" y="374" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t5_di" bpmnElement="t5"><dc:Bounds x="992" y="181" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t6_di" bpmnElement="t6"><dc:Bounds x="1142" y="311" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t7_di" bpmnElement="t7"><dc:Bounds x="1292" y="441" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g2_di" bpmnElement="g2" isMarkerVisible="true"><dc:Bounds x="1475" y="450" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1450" y="504" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t8_di" bpmnElement="t8"><dc:Bounds x="1592" y="311" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e1_di" bpmnElement="e1"><dc:Bounds x="1782" y="457" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1750" y="497" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_c1_asis_1_di" bpmnElement="Flow_c1_asis_1"><di:waypoint x="168" y="215" /><di:waypoint x="242" y="215" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_c1_asis_2_di" bpmnElement="Flow_c1_asis_2"><di:waypoint x="300" y="181" /><di:waypoint x="300" y="85" /><di:waypoint x="392" y="85" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_c1_asis_3_di" bpmnElement="Flow_c1_asis_3"><di:waypoint x="450" y="119" /><di:waypoint x="450" y="215" /><di:waypoint x="542" y="215" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_c1_asis_4_di" bpmnElement="Flow_c1_asis_4"><di:waypoint x="600" y="249" /><di:waypoint x="600" y="345" /><di:waypoint x="692" y="345" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_c1_asis_5_di" bpmnElement="Flow_c1_asis_5"><di:waypoint x="808" y="345" /><di:waypoint x="875" y="345" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_c1_asis_6_di" bpmnElement="Flow_c1_asis_6"><di:waypoint x="900" y="320" /><di:waypoint x="900" y="215" /><di:waypoint x="992" y="215" /><bpmndi:BPMNLabel><dc:Bounds x="906" y="197" width="40" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_c1_asis_7_di" bpmnElement="Flow_c1_asis_7"><di:waypoint x="925" y="345" /><di:waypoint x="1142" y="345" /><bpmndi:BPMNLabel><dc:Bounds x="931" y="327" width="40" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_c1_asis_8_di" bpmnElement="Flow_c1_asis_8"><di:waypoint x="1050" y="249" /><di:waypoint x="1050" y="398" /><di:waypoint x="750" y="398" /><di:waypoint x="750" y="379" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_c1_asis_9_di" bpmnElement="Flow_c1_asis_9"><di:waypoint x="1200" y="379" /><di:waypoint x="1200" y="475" /><di:waypoint x="1292" y="475" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_c1_asis_10_di" bpmnElement="Flow_c1_asis_10"><di:waypoint x="1408" y="475" /><di:waypoint x="1475" y="475" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_c1_asis_11_di" bpmnElement="Flow_c1_asis_11"><di:waypoint x="1500" y="450" /><di:waypoint x="1500" y="345" /><di:waypoint x="1592" y="345" /><bpmndi:BPMNLabel><dc:Bounds x="1506" y="327" width="40" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_c1_asis_12_di" bpmnElement="Flow_c1_asis_12"><di:waypoint x="1525" y="475" /><di:waypoint x="1782" y="475" /><bpmndi:BPMNLabel><dc:Bounds x="1531" y="457" width="40" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_c1_asis_13_di" bpmnElement="Flow_c1_asis_13"><di:waypoint x="1650" y="379" /><di:waypoint x="1650" y="528" /><di:waypoint x="1350" y="528" /><di:waypoint x="1350" y="509" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
