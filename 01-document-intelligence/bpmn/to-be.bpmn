<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_c1_tobe" targetNamespace="https://halverdijk.example/bpmn" exporter="construction-digital-transformation/scripts/bpmn.mjs" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_c1_tobe">
    <bpmn:documentation>Gewenste werkwijze: AI leest de bon, elf regels beslissen of een mens moet kijken. Alleen schone bonnen gaan automatisch naar het ERP; asbest en dubbels nooit.</bpmn:documentation>
    <bpmn:participant id="Pool_c1_tobe" name="Halverdijk Recycling" processRef="Process_c1_tobe" />
  </bpmn:collaboration>
  <bpmn:process id="Process_c1_tobe" name="TO-BE — document intelligence met menselijke controle" isExecutable="false">
    <bpmn:laneSet id="LaneSet_c1_tobe">
      <bpmn:lane id="Lane_c1_tobe_wb" name="Weegbrug / vervoerder">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_c1_tobe_flow" name="Power Automate + AI">
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_c1_tobe_rev" name="Administratie (reviewer)">
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_c1_tobe_env" name="Milieu-coördinator">
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_c1_tobe_erp" name="ERP / facturatie">
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Bon gescand of gemaild">
      <bpmn:outgoing>Flow_c1_tobe_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="s1_msg" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="t1" name="Document ophalen (postvak / scanmap)">
      <bpmn:incoming>Flow_c1_tobe_1</bpmn:incoming>
      <bpmn:outgoing>Flow_c1_tobe_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t2" name="Classificeren en velden extraheren (AI)">
      <bpmn:documentation>Azure AI Document Intelligence (custom extraction model) of AI Builder; geeft per veld een waarde en een confidence.</bpmn:documentation>
      <bpmn:incoming>Flow_c1_tobe_2</bpmn:incoming>
      <bpmn:outgoing>Flow_c1_tobe_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="t3" name="Elf controles R01–R11">
      <bpmn:incoming>Flow_c1_tobe_3</bpmn:incoming>
      <bpmn:outgoing>Flow_c1_tobe_4</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="g1" name="Uitkomst?" default="Flow_c1_tobe_8">
      <bpmn:incoming>Flow_c1_tobe_4</bpmn:incoming>
      <bpmn:outgoing>Flow_c1_tobe_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_c1_tobe_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_c1_tobe_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_c1_tobe_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e2" name="Gearchiveerd als dubbel">
      <bpmn:incoming>Flow_c1_tobe_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="t5" name="Gemarkeerde velden nakijken en corrigeren">
      <bpmn:incoming>Flow_c1_tobe_6</bpmn:incoming>
      <bpmn:outgoing>Flow_c1_tobe_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t6" name="Weigeren of uitzonderlijk aanvaarden">
      <bpmn:incoming>Flow_c1_tobe_7</bpmn:incoming>
      <bpmn:outgoing>Flow_c1_tobe_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g2" name="Bon correct?" default="Flow_c1_tobe_11">
      <bpmn:incoming>Flow_c1_tobe_9</bpmn:incoming>
      <bpmn:outgoing>Flow_c1_tobe_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_c1_tobe_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g3" name="Aanvaarden?" default="Flow_c1_tobe_13">
      <bpmn:incoming>Flow_c1_tobe_12</bpmn:incoming>
      <bpmn:outgoing>Flow_c1_tobe_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_c1_tobe_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e3" name="Afgewezen, vervoerder verwittigd">
      <bpmn:incoming>Flow_c1_tobe_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="t7" name="Klant en vervoerder verwittigen">
      <bpmn:incoming>Flow_c1_tobe_13</bpmn:incoming>
      <bpmn:outgoing>Flow_c1_tobe_15</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="e4" name="Lading geweigerd">
      <bpmn:incoming>Flow_c1_tobe_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="t4" name="Weging boeken in ERP (API, idempotent)">
      <bpmn:incoming>Flow_c1_tobe_8</bpmn:incoming>
      <bpmn:incoming>Flow_c1_tobe_11</bpmn:incoming>
      <bpmn:incoming>Flow_c1_tobe_14</bpmn:incoming>
      <bpmn:outgoing>Flow_c1_tobe_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t8" name="Archiveren + KPI-log">
      <bpmn:incoming>Flow_c1_tobe_16</bpmn:incoming>
      <bpmn:outgoing>Flow_c1_tobe_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e1" name="Klaar voor facturatie">
      <bpmn:incoming>Flow_c1_tobe_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_c1_tobe_1" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="Flow_c1_tobe_2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="Flow_c1_tobe_3" sourceRef="t2" targetRef="t3" />
    <bpmn:sequenceFlow id="Flow_c1_tobe_4" sourceRef="t3" targetRef="g1" />
    <bpmn:sequenceFlow id="Flow_c1_tobe_5" sourceRef="g1" targetRef="e2" name="dubbel" />
    <bpmn:sequenceFlow id="Flow_c1_tobe_6" sourceRef="g1" targetRef="t5" name="nazicht" />
    <bpmn:sequenceFlow id="Flow_c1_tobe_7" sourceRef="g1" targetRef="t6" name="geweigerd" />
    <bpmn:sequenceFlow id="Flow_c1_tobe_8" sourceRef="g1" targetRef="t4" name="alles ok" />
    <bpmn:sequenceFlow id="Flow_c1_tobe_9" sourceRef="t5" targetRef="g2" />
    <bpmn:sequenceFlow id="Flow_c1_tobe_10" sourceRef="g2" targetRef="e3" name="nee" />
    <bpmn:sequenceFlow id="Flow_c1_tobe_11" sourceRef="g2" targetRef="t4" name="ja" />
    <bpmn:sequenceFlow id="Flow_c1_tobe_12" sourceRef="t6" targetRef="g3" />
    <bpmn:sequenceFlow id="Flow_c1_tobe_13" sourceRef="g3" targetRef="t7" name="nee" />
    <bpmn:sequenceFlow id="Flow_c1_tobe_14" sourceRef="g3" targetRef="t4" name="uitzondering" />
    <bpmn:sequenceFlow id="Flow_c1_tobe_15" sourceRef="t7" targetRef="e4" />
    <bpmn:sequenceFlow id="Flow_c1_tobe_16" sourceRef="t4" targetRef="t8" />
    <bpmn:sequenceFlow id="Flow_c1_tobe_17" sourceRef="t8" targetRef="e1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_c1_tobe">
    <bpmndi:BPMNPlane id="Plane_c1_tobe" bpmnElement="Collab_c1_tobe">
      <bpmndi:BPMNShape id="Pool_c1_tobe_di" bpmnElement="Pool_c1_tobe" isHorizontal="true"><dc:Bounds x="20" y="20" width="1750" height="650" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_c1_tobe_wb_di" bpmnElement="Lane_c1_tobe_wb" isHorizontal="true"><dc:Bounds x="50" y="20" width="1720" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_c1_tobe_flow_di" bpmnElement="Lane_c1_tobe_flow" isHorizontal="true"><dc:Bounds x="50" y="150" width="1720" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_c1_tobe_rev_di" bpmnElement="Lane_c1_tobe_rev" isHorizontal="true"><dc:Bounds x="50" y="280" width="1720" height="130" /></bpmndi:BPMNShape>
