      <bpmndi:BPMNShape id="t4_di" bpmnElement="t4"><dc:Bounds x="1292" y="571" width="116" height="68" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t8_di" bpmnElement="t8"><dc:Bounds x="1442" y="571" width="116" height="68" /></bpmndi:BPMNShape>
