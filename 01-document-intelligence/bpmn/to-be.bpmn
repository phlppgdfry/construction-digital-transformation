      <bpmndi:BPMNEdge id="Flow_c1_tobe_1_di" bpmnElement="Flow_c1_tobe_1"><di:waypoint x="150" y="103" /><di:waypoint x="150" y="215" /><di:waypoint x="242" y="215" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_c1_tobe_2_di" bpmnElement="Flow_c1_tobe_2"><di:waypoint x="358" y="215" /><di:waypoint x="392" y="215" /></bpmndi:BPMNEdge>
